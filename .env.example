# Flask Configuration
FLASK_ENV=production
SECRET_KEY=generate_a_secure_secret_key_here_for_production
APP_PORT=5000

# PostgreSQL Configuration
POSTGRES_DB=document_vault
POSTGRES_USER=vault_user
POSTGRES_PASSWORD=vault_secure_password_replace_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Storage Configuration
# Inside Docker container, this must match the volume mount (/app/uploads)
# For local development outside Docker, set to ./uploads
UPLOAD_FOLDER=/app/uploads

# Maximum Upload File Size in Bytes (default: 16 MB = 16 * 1024 * 1024)
MAX_CONTENT_LENGTH=16777216
